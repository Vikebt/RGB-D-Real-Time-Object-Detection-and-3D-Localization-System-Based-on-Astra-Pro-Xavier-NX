<?xml version="1.0"?>
<package format="2">
  <name>astra_rgbd_perception</name>
  <version>0.1.0</version>
  <description>RGB-D synchronization, point cloud, YOLO TensorRT detection and 3D localization for Astra Pro on Jetson Xavier NX.</description>

  <maintainer email="hs-3@example.com">hs-3</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>roslib</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>message_filters</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>rosbag</exec_depend>
</package>